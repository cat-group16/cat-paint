<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="8dp">

    <TextView
        android:id="@+id/appwidget_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="Cat Paint"
        android:textColor="@android:color/black"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/widget_controls"
        android:layout_below="@id/appwidget_text"
        android:layout_margin="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_cat_decoration"
        android:alpha="0.8"/>

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_clear"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="#EEEEEE"
            android:text="Pulisci"
            android:textColor="@android:color/black"
            android:textSize="10sp" />

        <Button
            android:id="@+id/widget_btn_save"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="#EEEEEE"
            android:text="Salva"
            android:textColor="@android:color/black"
            android:textSize="10sp" />

    </LinearLayout>

</RelativeLayout>